sanatansetulibrary.com, www.sanatansetulibrary.com {
    encode gzip zstd

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /admin/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /static/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /var/www/sanatansetu/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
