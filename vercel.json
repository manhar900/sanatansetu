{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|assets/|robots\\.txt|manifest\\.json|sanatan-global-db\\.json|.*\\.(?:png|ico|svg|jpg|jpeg|webp|xml|txt)$).*)",
      "destination": "/index.html"
    }
  ]
}